# OSA environment template (5.3).
# Copy this file to .env and fill in values as needed:
#     cp .env.example .env
# .env is git-ignored. Do NOT commit real tokens or keys.

# --- Models ---------------------------------------------------------------

# Base URL for llama-server (both reasoning and vision use it unless overridden
# in config/default.yaml).
# Default: http://127.0.0.1:8080
OSA_LLAMA_URL=

# tool_choice for the reasoning model: auto | required | none.
# `required` forces a tool call on every turn (useful if the model talks
# instead of acting). Overrides agent.tool_choice in config/default.yaml.
# Default: auto
OSA_TOOL_CHOICE=

# Path to a custom system prompt file. If unset, the bundled
# src/osa/prompts/system_ru.txt is used.
OSA_SYSTEM_PROMPT=

# --- Paths ----------------------------------------------------------------

# Where OSA stores memory, settings, logs and screenshots.
# Default: ~/.osa
OSA_HOME=

# Folder for SafeFilesystem and SafeShell. Default: current working directory.
OSA_WORKSPACE=

# --- Voice ----------------------------------------------------------------

# Whisper model size for terminal background listening: tiny | base | small | medium
# Default: small
OSA_STT_MODEL=

# Optional transcript debug log (local only, never sent anywhere):
#   1    — log sizes and decisions only
#   text — also log recognized phrases
# Unset — disabled
OSA_VOICE_DEBUG=

# Seconds the microphone stays open after a wake word ("Оса, ...") without
# requiring the wake word again. Range: 0-300.
# Default: 20
OSA_FOLLOW_UP_SECONDS=

# --- Tests ----------------------------------------------------------------

# Set to 1 to run the live audio smoke tests (requires a real microphone).
OSA_RUN_LIVE_AUDIO=
